# Copy to .env and fill in. Never commit .env.
# Both values come from the Command Center's Supabase project (Doppler holds them):
#   SUPABASE_SERVICE_ROLE_KEY bypasses row-level security. Local machine only.
SUPABASE_URL=https://YOUR_SUPABASE_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key

# Optional. Which gosom to use: native (a Go binary) or docker.
# The setup script writes data/.engine for you; this overrides it.
# LEADS_ENGINE=native

# Optional. Which niche definition in niches/ is the default.
# LEADS_NICHE=home_services

# Optional. The name shown against a run in the app's history, so you can tell the
# Mac's runs from the PC's. Defaults to the machine's hostname.
# LEADS_HOST=jake-mac
