# Cloudflare Pages response headers.
#
# frame-ancestors 'self' allows exactly one thing: the app framing itself. That
# is what the admin Fulfillment "Software" tab does when it previews a client's
# pages inside the cockpit. Every other site is blocked from framing the app,
# which closes off clickjacking.
#
# Deliberately frame-ancestors rather than X-Frame-Options: DENY/SAMEORIGIN
# cannot express "self only" as reliably across browsers, and CSP supersedes it
# where both are present.
/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# /sites/ and /funnel/ hold pages and assets that render on OTHER origins:
# GoHighLevel draws the pre-call and funnel pages, and pulls these files in
# from here. A <track> caption file is CORS-checked even when the <video> it
# hangs off is not, and the moment you set crossorigin on the video to make
# the track load, the media file needs the header too. Without this the
# captions fail silently: no error, no subtitles, just a player that looks
# like it never had any.
/sites/*
  Access-Control-Allow-Origin: *

/funnel/*
  Access-Control-Allow-Origin: *
