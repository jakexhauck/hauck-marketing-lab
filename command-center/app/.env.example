# Copy to .env.local and fill in the real values.
# .env.local is gitignored. Production values live in Cloudflare Pages env vars.

# ---- Frontend (Vite, exposed to the browser bundle) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---- Pages Functions only (server-side, never exposed to browser) ----
# Set these in Cloudflare Pages -> Settings -> Variables and Secrets.
# Listed here so you remember what the API needs.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
WEBHOOK_SECRET=generate-a-32-char-random-string

# ---- GoHighLevel (per-client sub-account) ----
GHL_TOKEN=pit-...
GHL_LOCATION_ID=...

# ---- Local tooling only (never deployed; keep in .env.local) ----
# Supabase Personal Access Token (dashboard > Account > Access Tokens).
# Powers `npm run db:migrate` (applies schema via the Management API).
SUPABASE_ACCESS_TOKEN=sbp_...
# Cloudflare API token (dashboard > My Profile > API Tokens > Create Token,
# permission: Account > Cloudflare Pages > Edit). Powers `npm run cf ...`
# (set env vars / secrets, watch deploys) so the CF dashboard is not needed.
CLOUDFLARE_API_TOKEN=
# Optional: only needed if the token sees more than one Cloudflare account.
CLOUDFLARE_ACCOUNT_ID=

# ---- Deploy target ----
PAGES_HOSTNAME=hauck-dashboard.pages.dev

# ---- VAPID (generated in section 06) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
