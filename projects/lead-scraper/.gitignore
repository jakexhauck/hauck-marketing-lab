.env
.venv/
__pycache__/
*.pyc

# Run artefacts. The queue and the scrape output are per-machine and disposable;
# the suppression list is NOT (it is the permanent do-not-contact record), so it is
# tracked deliberately.
data/queue*.jsonl
data/b_*.json
data/b_*.queries.txt
data/.engine
out/
logs/
!data/metros.json
!data/suppression.txt

# One-off operational undo records (contain lead names). They live in data/, so
# that is the only place the rules need to cover: hvac_softdelete_undo.json used
# to be listed here for a file that sat in the repo root describing a soft delete
# through a deleted_at column this table has never had. Deleted 2026-08-21; the
# real HVAC undo is data/retire_hvac_undo.json.
data/regrade_undo.json
data/retire_*_undo.json
