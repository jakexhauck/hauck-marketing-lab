{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hauck Marketing Lab",
  "version": "0.1.0",
  "identifier": "com.hauckmarketing.lab",
  "build": {
    "beforeDevCommand": "npx vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npx tsc && npx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hauck Marketing Lab",
        "width": 1440,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 800,
        "decorations": true,
        "backgroundColor": "#08090d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
