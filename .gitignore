*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Env / secrets
.env
.env.local
.env.*.local

# Cloudflare Wrangler local secrets (never commit)
.dev.vars
**/.dev.vars

# App runtime config (per-machine paths, not portable)
app-config.local.json

# Per-client Meta credentials (unencrypted secrets — never commit)
data/*/credentials.yaml

# Lead scraper Google service account (never commit)
lead-scraper/credentials.json
lead-scraper/credentials*.json

# Google Calendar OAuth client (desktop-app creds, but keep out of repo for push protection)
app/src-tauri/src/google_oauth_secrets.rs

# Meta Marketing API System User token (full ads_read on Hauck business portfolio — never commit)
app/src-tauri/src/meta_oauth_secrets.rs

# Supabase service-role key for client-dashboard provisioning (bypasses RLS — never commit)
app/src-tauri/src/supabase_secrets.rs

# Claude Code per-developer state
.claude/settings.local.json
.claude/worktrees/

# Playwright MCP browser session artifacts (console logs, profile)
.playwright-mcp/

# Local GHL audit dumps (contains real contact/opportunity PII — never commit)
.ghl-audit/

# local GitHub token, never commit
scripts/.gh_token
.worktrees/
