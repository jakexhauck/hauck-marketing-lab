        "q1": {
          "type": "qa",
          "settings": {
            "q": "How long does shipping take?",
            "a": "<p>Orders leave the workshop within one to two business days. Shipping is free on orders over $50.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "q": "How should I store the tea?",
            "a": "<p>Somewhere cool, dry and out of direct light. The kraft pouch reseals; keep it closed and the blend holds for about twelve months.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "q": "Is the tea caffeinated?",
            "a": "<p>Morning Ritual is. Evening Ritual is caffeine free, which is rather the point of it.</p>"
          }
        },
        "q4": {
          "type": "qa",
          "settings": {
            "q": "Can I return an order?",
            "a": "<p>Write to us within thirty days and we will make it right.</p>"
          }
        }
      },
